# ExifTool config file shipped with the Sony Aspect Marker Crop Lightroom plugin.
#
# Gives Sony MakerNote tag 0x2049 a stable name, "AspectMarker", so the
# plugin can ask for it by name whatever ExifTool version is installed.
# ExifTool itself does not decode this tag yet (as of 13.59). It holds the
# aspect ratio of the still-image Aspect Marker as two rationals, for example
# 235/100 1/1 for 2.35:1, or 0/0 0/0 when the marker display was off.
#
# Handy on its own, too:
#   exiftool -config AspectMarkerCrop.config -Sony:AspectMarker photo.ARW

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Sony::Main' => {
        0x2049 => { Name => 'AspectMarker' },
    },
);

1;  # end
